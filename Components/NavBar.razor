@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<nav class="nav">
    <div class="wrap nav__inner">
        <a class="nav__brand" href="/" @onclick="CloseMenu">@Profile.Initials<span aria-hidden="true">_</span></a>

        <div class="nav__links">
            @foreach (var (id, label) in _sections)
            {
                <a class="nav__link" data-nav="@id" href="/#@id">@label</a>
            }
            <a class="nav__link" href="/blogs">Blog</a>
        </div>

        <div class="nav__actions">
            <ThemeToggle />
            <button class="icon-btn nav__toggle" @onclick="ToggleMenu"
                    aria-label="Toggle menu" aria-expanded="@_open.ToString().ToLowerInvariant()">
                @(_open ? "✕" : "≡")
            </button>
        </div>
    </div>

    <div class="nav__mobile @(_open ? "open" : "")">
        @foreach (var (id, label) in _sections)
        {
            <a href="/#@id" @onclick="CloseMenu">@label</a>
        }
        <a href="/blogs" @onclick="CloseMenu">Blog</a>
    </div>
</nav>

@code {
    private bool _open;

    private readonly (string Id, string Label)[] _sections =
    {
        ("about", "About"),
        ("skills", "Skills"),
        ("work", "Work"),
        ("projects", "Projects"),
        ("contact", "Contact"),
    };

    private void ToggleMenu() => _open = !_open;

    [JSInvokable]
    public void CloseMenu()
    {
        if (!_open) return;
        _open = false;
        StateHasChanged();
    }

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await SafeInitScrollSpy();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _open = false;
        StateHasChanged();
        await Task.Delay(150);          // let the new page render
        await SafeInitScrollSpy();
    }

    private async Task SafeInitScrollSpy()
    {
        try
        {
            await JS.InvokeVoidAsync("profileWeb.initScrollSpy");
            await JS.InvokeVoidAsync("profileWeb.scrollToHash");
        }
        catch { /* JS not ready / component gone */ }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
